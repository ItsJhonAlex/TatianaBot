# ===========================================
# TatianaBot v2 — Variables de entorno
# ===========================================
# Copia este archivo a .env y completa los valores.
# Bun carga .env automáticamente (no hace falta dotenv).
# Solo las marcadas como REQUERIDAS son obligatorias para arrancar.

# --- REQUERIDAS ---

# Token del bot de Discord
DISCORD_TOKEN=

# API key de Groq (IA)
GROQ_API_KEY=

# Modelo Groq (opcional; default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# ID del usuario autorizado para comandos admin (/shutdown, /restart)
AUTHORIZED_USER_ID=

# --- OPCIONALES ---

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# URL de base de datos (SQLite por defecto)
DATABASE_URL=file:./data/tatiana.db

# Guild de desarrollo para registro rápido de slash commands
# DEV_GUILD_ID=

# Canal donde se publica el embed de estado del bot
# STATUS_CHANNEL_ID=

# --- MÚSICA (opcional, Fase 5) ---
# Requiere Lavalink v4. Ver docs/lavalink.md
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_SECURE=false
# Descarga temporal estilo Telegram (requiere yt-dlp en PATH): default true
# MUSIC_USE_DOWNLOAD=true
# MUSIC_CACHE_DIR=./data/music-cache
# LAVALINK_CACHE_DIR=/music-cache
# YTDLP_PATH=yt-dlp
# Cookies del navegador para YouTube (evita "Sign in to confirm you're not a bot").
# Debes tener sesión iniciada en YouTube en ese navegador.
# Si el perfil no está en la ruta por defecto (~/.mozilla, ~/.config/chromium),
# indícala explícitamente: firefox:/ruta/al/perfil
# YTDLP_COOKIES_FROM_BROWSER=firefox

# ===========================================
# Variables del legacy — NO usar en v2
# (se eliminaron: GEMINI, SPOTIFY, GITHUB, MONITOR, CHANNEL_ID)
# ===========================================
