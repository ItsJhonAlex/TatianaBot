{
  "name": "tatianabot",
  "version": "2.5.0",
  "description": "Tatiana — bot de Discord con IA y mundo Aethoria",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun src/infrastructure/db/migrate.ts",
    "db:studio": "bunx drizzle-kit studio"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "dependencies": {
    "@sapphire/framework": "^5.5.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.5.0",
    "pino": "^10.3.1",
    "shoukaku": "^4.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
